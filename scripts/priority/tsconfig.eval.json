{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": false,
    "outDir": "../../.eval-build",
    "rootDir": "../..",
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "./**/*.ts",
    "../../src/types/index.ts",
    "../../src/lib/priority-engine/**/*.ts"
  ],
  "exclude": [
    "../../src/lib/priority-engine/pipeline.ts"
  ]
}
